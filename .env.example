# Copier ce fichier en .env (jamais commité : ajouter .env au .gitignore)
# et remplacer les valeurs par des mots de passe robustes.
#   openssl rand -base64 24
DB_PASSWORD=change-me-wp-user
DB_ROOT_PASSWORD=change-me-root

# Image WordPress personnalisée (écrite automatiquement par le pipeline ;
# à renseigner seulement pour un lancement manuel, nom en minuscules)
WP_IMAGE=ghcr.io/votre-compte/wordpress-custom:latest

# --- Supervision (Prometheus + Grafana, voir docker-compose.monitoring.yml) ---
# Active le fichier Compose de supervision avec le reste de la stack.
# (écrit automatiquement par le pipeline ; à garder pour un lancement manuel)
COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml
# Mots de passe : éviter les caractères ' " \ $ (ils cassent le SQL et les fichiers de config)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
MYSQL_EXPORTER_PASSWORD=change-me-exporter
# Adresse sur laquelle Grafana écoute : 127.0.0.1 = depuis la VM uniquement ;
# mettre l'adresse de la VM sur le réseau WireGuard pour y accéder à distance.
GRAFANA_BIND=127.0.0.1
# Durée de conservation des métriques
PROM_RETENTION=15d
