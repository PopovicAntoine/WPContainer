# Copier ce fichier en .env (jamais commité : ajouter .env au .gitignore)
# et remplacer les valeurs par des mots de passe robustes.
#   openssl rand -base64 24
DB_PASSWORD=change-me-wp-user
DB_ROOT_PASSWORD=change-me-root

# Image WordPress personnalisée (écrite automatiquement par le pipeline ;
# à renseigner seulement pour un lancement manuel, nom en minuscules)
WP_IMAGE=ghcr.io/votre-compte/wordpress-custom:latest
